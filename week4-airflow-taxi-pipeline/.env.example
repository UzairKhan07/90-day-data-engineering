# Airflow web UI admin login
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me

# Taxi data warehouse Postgres
POSTGRES_TAXI_USER=user
POSTGRES_TAXI_PASSWORD=change_me
POSTGRES_TAXI_DB=yellowtaxi

# Airflow metadata Postgres
POSTGRES_AIRFLOW_USER=airflow
POSTGRES_AIRFLOW_PASSWORD=change_me

# pgAdmin login
PGADMIN_EMAIL=admin@local.com
PGADMIN_PASSWORD=change_me

# Kaggle API — from kaggle.com > Account > Create New API Token
KAGGLE_USERNAME=
KAGGLE_KEY=

# Required on Linux/WSL so container file perms match your host user; safe to leave as-is on Docker Desktop
AIRFLOW_UID=50000
